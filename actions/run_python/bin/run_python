#!/usr/bin/env python3

import argparse
import os
import subprocess
import sys
import tempfile
import uuid


def _combine_output(stdout: str, stderr: str) -> str:
    stdout = stdout or ""
    stderr = stderr or ""
    if stdout and stderr:
        return stdout + ("\n" if not stdout.endswith("\n") else "") + stderr
    return stdout or stderr


def main() -> int:
    parser = argparse.ArgumentParser(description="Execute Python code and return output")
    parser.add_argument("--script", required=True, help="Python script content to execute")
    parser.add_argument("--timeout", type=int, default=30, help="Timeout in seconds (default: 30)")
    parser.add_argument("--python", default="python3", help="Python executable to use (default: python3)")

    args = parser.parse_args()

    temp_filename = os.path.join(tempfile.gettempdir(), f"python_exec_{uuid.uuid4().hex}.py")

    try:
        with open(temp_filename, "w", encoding="utf-8") as f:
            f.write(args.script)

        result = subprocess.run(
            [args.python, temp_filename],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=args.timeout,
        )

        combined = _combine_output(result.stdout, result.stderr)
        if combined:
            print(combined, end="" if combined.endswith("\n") else "\n")

        if result.returncode != 0:
            if not result.stderr:
                print(f"Process exited with code {result.returncode}")
            return result.returncode if result.returncode != 0 else 1

        return 0

    except subprocess.TimeoutExpired:
        print(f"Execution timeout: Code took too long to execute (>{args.timeout}s)")
        return 124

    except FileNotFoundError:
        print(f"Python executable not found: {args.python}")
        return 127

    except Exception as e:
        print(f"Execution error: {e}")
        return 1

    finally:
        try:
            os.remove(temp_filename)
        except Exception:
            pass


if __name__ == "__main__":
    raise SystemExit(main())
